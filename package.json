{
  "name": "@toreda/nodep-toolbox",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}))\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "test": "jest --coverage --maxWorkers=50%",
    "test:fast": "jest --coverage=false --maxWorkers=50%",
    "test:ci": "jest --ci --coverage --maxWorkers=50% --silent --verbose=false",
    "test:silent": "jest --coverage=false --maxWorkers=50% --silent --verbose=false"
  },
  "prettier": "@toreda/prettier-config",
  "keywords": [],
  "author": "Toreda, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/toreda/toolbox/issues"
  },
  "homepage": "https://github.com/toreda/toolbox#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@toreda/eslint-config": "^3.1.0",
    "@toreda/prettier-config": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  }
}
